// ## libc

// `free`, for the two MLT answers that are `malloc`'d and the caller's: neither is bound yet, and
// the declaration is here so that the one that is added frees what it is given.
extern "free" free(p: *u8)

// `strdup`, for a profile's description, which `mlt_profile_close` frees.
extern "strdup" strdup(s: *u8) -> *u8

// `setenv`, for `MLT_REPOSITORY_DENY`, which MLT reads from the environment when the repository loads.
extern "setenv" setenv(name: *u8, value: *u8, overwrite: i32) -> i32

c const
    PROFILE_SIZE: usize = "sizeof(struct mlt_profile_s)"
    COLOR_SIZE: usize = "sizeof(mlt_color)"
    EVENT_DATA_SIZE: usize = "sizeof(mlt_event_data)"

    IMAGE_NONE: i32 = "mlt_image_none"
    IMAGE_RGB: i32 = "mlt_image_rgb"
    IMAGE_RGBA: i32 = "mlt_image_rgba"
    IMAGE_YUV422: i32 = "mlt_image_yuv422"
    IMAGE_YUV420P: i32 = "mlt_image_yuv420p"

    AUDIO_NONE: i32 = "mlt_audio_none"
    AUDIO_S16: i32 = "mlt_audio_s16"
    AUDIO_S32: i32 = "mlt_audio_s32"
    AUDIO_FLOAT: i32 = "mlt_audio_float"
    AUDIO_S32LE: i32 = "mlt_audio_s32le"
    AUDIO_F32LE: i32 = "mlt_audio_f32le"
    AUDIO_U8: i32 = "mlt_audio_u8"

    TIME_FRAMES: i32 = "mlt_time_frames"
    TIME_CLOCK: i32 = "mlt_time_clock"
    TIME_SMPTE_DF: i32 = "mlt_time_smpte_df"
    TIME_SMPTE_NDF: i32 = "mlt_time_smpte_ndf"
