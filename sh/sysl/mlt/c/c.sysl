// MLT's C API (`framework/mlt.h`), declared verbatim.
//
// **The declarations over the library the machine has.** Nothing here is meant to be called by a
// program: every name and convention is C's, so an object is a pointer whose lifetime is a reference
// count, a failure is a non-zero integer or a null pointer, and a callback is one word of code with a
// `void *` beside it. The module above this one turns those into sysl and is what an application
// imports.
//
// **Every MLT object is a `struct` whose first member is the one it extends** — a producer begins
// with a service, and a service with a property bag — so the `*_properties` and `*_service` calls
// below answer the same address under another type. They are declared rather than replaced with a
// cast so that each step down the chain is the library's own.

module sh.sysl.mlt.c
@link("mlt-7")

@include("framework/mlt.h")

opaque struct Repository
opaque struct Properties
opaque struct Service
opaque struct Producer
opaque struct Playlist
opaque struct Multitrack
opaque struct Tractor
opaque struct Field
opaque struct Filter
opaque struct Transition
opaque struct Consumer
opaque struct Frame
opaque struct Event

// `struct mlt_profile_s`, the one MLT object whose layout is published; `tests.sysl` asserts its size
// against the header's.
struct Profile
    description: *u8
    frame_rate_num: i32
    frame_rate_den: i32
    width: i32
    height: i32
    progressive: i32
    sample_aspect_num: i32
    sample_aspect_den: i32
    display_aspect_num: i32
    display_aspect_den: i32
    colorspace: i32
    is_explicit: i32
end Profile

// `mlt_color`, passed by value.
struct Color
    r: u8
    g: u8
    b: u8
    a: u8

// `mlt_event_data` is a struct holding an untagged union of an `int` and a `void *`. sysl has no
// spelling for the union, and needs none: the struct is one pointer-sized word in both conventions
// this package builds for, and MLT supplies `mlt_event_data_to_*` to read it, so it is carried as the
// word it is and never read here. `tests.sysl` asserts the size.
struct EventData
    word: *u8

